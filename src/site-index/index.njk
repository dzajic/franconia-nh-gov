---
layout: shell.njk
permalink: /site-index/
title: "Everything on the site — Town of Franconia"
description: "Public pages that are not already listed with departments, forms, the calendar, or minutes."
---
<main id="main" class="in page" data-pagefind-body>
  <h1 id="directory" class="page-title">Everything on the site</h1>
  <p class="lede">Departments, forms, the calendar, and minutes are on the homepage. This page lists the other public pages.</p>
  <section class="dirs" aria-label="Site index">
    {% for group in directory | siteIndex(departments, forms, tasks, events) %}
    <section class="dg" aria-labelledby="dg{{ loop.index0 }}">
      <h3 id="dg{{ loop.index0 }}"><span class="blaze" aria-hidden="true"></span>{{ group.heading }}</h3>
      <ul class="link-grid">
        {% for item in group.pages %}
        <li><a href="{% if item.href | startsWith('/') %}{{ item.href | url }}{% else %}{{ item.href }}{% endif %}">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  </section>
</main>
