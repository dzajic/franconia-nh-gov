---
layout: shell.njk
---
{% set board = bodies | findBody(body) %}
{% set committee = board.name if board else body %}
{% set notes = content | splitRecordNote %}
{% set fileKind = "" %}
{% if format == "pdf" %}{% set fileKind = "PDF" %}
{% elif format == "docx" %}{% set fileKind = "DOCX" %}
{% elif format == "doc" %}{% set fileKind = "DOC" %}
{% endif %}
<main id="main" class="in page" data-pagefind-body>
  <nav class="crumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="{{ '/archive/' | url }}">Document archive</a></li>
      <li><a href="{{ ('/archive/' + body + '/') | url }}">{{ committee }}</a></li>
    </ol>
  </nav>
  <h1 class="page-title">{{ title | recordHeading(committee) | balancedTitle | safe }}</h1>
  <p class="record-when">{{ doc_date | prettyDate(date_precision) }}</p>
  {% if needs_review %}
  <div class="review" role="note">
    <strong>Needs review</strong>
    <p>A person still needs to check this record. The date, the committee, or the kind of document may not be exact.</p>
  </div>
  {% endif %}
  {% if missing %}
  <div class="review" role="note">
    <strong>File not uploaded yet</strong>
    <p>This file was missing from the previous town website. The button below will open it after the town uploads a copy.</p>
  </div>
  {% endif %}
  <div class="file-actions">
    <a class="open-file" href="{{ file | archiveFileUrl }}">View</a>
    {% if fileKind %}<p class="file-type">{{ fileKind }}</p>{% endif %}
  </div>
  {% if legacy_url and not missing %}
  <p class="record-fallback">If the button does not open the file, use the <a href="{{ legacy_url }}">current copy on franconianh.gov</a>.</p>
  {% endif %}
  {% if notes.visible %}
  <div class="prose">{{ notes.visible | safe }}</div>
  {% endif %}
  <details class="record-about">
    <summary><h2>About this record</h2></summary>
    <p class="note about-note">The View button points at document storage. This website does not keep the file.</p>
    <dl class="meta-dl">
      <dt>Needs review</dt>
      <dd>{% if needs_review %}Yes{% else %}No{% endif %}</dd>
      <dt>Checksum</dt>
      <dd>{% if checksum %}<code>{{ checksum }}</code>{% else %}Not recorded{% endif %}</dd>
      <dt>Flags</dt>
      <dd>{% if flags and flags.length %}{{ flags | join(", ") }}{% else %}None{% endif %}</dd>
      <dt>Legacy filename</dt>
      <dd>{% if legacy_filename %}<code>{{ legacy_filename }}</code>{% else %}Not recorded{% endif %}</dd>
      <dt>Legacy URL</dt>
      <dd>{% if legacy_url %}<a href="{{ legacy_url }}">{{ legacy_url }}</a>{% else %}Not recorded{% endif %}</dd>
      <dt>Text layer</dt>
      <dd>
        {%- if text_layer == false -%}
        Scanned or image-only. The words are not selectable, so search cannot read them yet.
        {%- elif text_layer == true -%}
        This PDF includes text that search can read.
        {%- else -%}
        Not recorded
        {%- endif -%}
      </dd>
      <dt>Status</dt>
      <dd>{{ status or "Not recorded" }}</dd>
      <dt>Date precision</dt>
      <dd>
        {%- if date_precision == "exact" -%}Exact date
        {%- elif date_precision == "month" -%}Month and year only
        {%- elif date_precision == "year" -%}Year only
        {%- elif date_precision == "unknown" -%}Unknown
        {%- elif date_precision -%}{{ date_precision }}
        {%- else -%}Not recorded
        {%- endif -%}
      </dd>
    </dl>
    {% if notes.provenance %}
    <div class="prose about-provenance">{{ notes.provenance | safe }}</div>
    {% endif %}
  </details>
</main>
