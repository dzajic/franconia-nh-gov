<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
      (function () {
        var px = { small: [16, 16], medium: [18, 16.5], large: [22, 18] };
        function stepFrom(saved) {
          if (saved === "small" || saved === "16") return "small";
          if (saved === "large" || saved === "22") return "large";
          if (saved === "medium" || saved === "18" || saved === "17" || saved === "19") return "medium";
          return "";
        }
        try {
          var step = stepFrom(localStorage.getItem("franconia-text-size"));
          if (!step) return;
          var narrow = window.matchMedia("(max-width: 640px)").matches;
          document.documentElement.style.fontSize = px[step][narrow ? 1 : 0] + "px";
          document.documentElement.setAttribute("data-text-size", step);
        } catch (err) {}
      })();
    </script>
    <title>{{ title or "Franconia, NH" }}</title>
    <meta name="description" content="{{ description or home.description }}">
    <link rel="canonical" href="{{ site.origin }}{{ page.url | url }}">
    <link rel="alternate" type="text/plain" href="{{ '/llms.txt' | url }}" title="llms.txt">
    <link rel="alternate" type="application/json" href="{{ '/town.json' | url }}">
    <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/pages.css' | url }}">
    {% include "partials/jsonld.njk" %}
    {% include "partials/season-head.njk" %}
  </head>
  <body class="{{ bodyClass or 'page' }}" data-pagefind="{{ '/pagefind/pagefind.js' | url }}" data-archive-index="{{ '/archive/index.json' | url }}" data-site-root="{{ '/' | url }}">
    <a class="skip" href="#main">Skip to main content</a>
    {% if site.previewNotice and site.previewNotice.enabled and site.previewNotice.text %}
    {% include "partials/preview-note.njk" %}
    {% elif showAlerts != false and alerts.length %}
    <aside class="alert" role="region" aria-label="Alerts">
      <div class="in">
        <b>Heads up</b>
        {% for alert in alerts %}
          {% if not loop.first %}<span class="dot" aria-hidden="true">·</span>{% endif %}
          <a href="{{ alert.href | url }}">{{ alert.text }}</a>
        {% endfor %}
      </div>
    </aside>
    {% endif %}
    {% include "partials/header.njk" %}
    {{ content | safe }}
    {% include "partials/footer.njk" %}
    <script src="{{ '/assets/text-size.js' | url }}" defer></script>
    <script src="{{ '/assets/nav-menu.js' | url }}" defer></script>
    {% if pageScript %}<script src="{{ pageScript | url }}" defer></script>{% endif %}
  </body>
</html>
