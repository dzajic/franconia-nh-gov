<footer class="foot" data-pagefind-ignore>
  {% if footerStyle != "simple" %}
  <div class="ridge">{% include "partials/footer-ridge.njk" %}</div>
  <div class="trees">{% include "partials/footer-trees.njk" %}</div>
  {% endif %}
  <div class="in fi">
    {% if footerStyle == "simple" %}
    <p><strong>Town of Franconia, New Hampshire</strong> · Clerk: {{ site.contact.phone }} · {{ site.contact.email }} · Hours: {{ site.contact.hours }}</p>
    <ul class="foot-links">
      <li><a href="{{ '/' | url }}"><span>Town homepage</span></a></li>
      <li><a href="{{ '/archive/' | url }}"><span>Document archive</span></a></li>
      <li><a href="{{ site.visiting.url }}"><span>{{ site.visiting.text }}</span></a></li>
    </ul>
    {% else %}
    <p><strong>Town of Franconia, New Hampshire</strong><br>Clerk: {{ site.contact.phone }} · {{ site.contact.email }} · {{ site.contact.address }} · Hours: {{ site.contact.hours }}</p>
    <ul class="foot-links">
      <li><a href="{{ '/about/' | url }}"><span>About Franconia</span></a></li>
      <li><a href="{{ site.visiting.url }}"><span>Visiting?</span></a></li>
      <li><a href="{{ site.suggestions }}"><span>Suggest a change</span></a></li>
      <li><a href="{{ '/archive/' | url }}"><span>Document archive</span></a></li>
      <li><a href="{{ site.visiting.url }}"><span>{{ site.visiting.text }}</span></a></li>
    </ul>
    {% endif %}
    {% include "partials/season-controls.njk" %}
    <p class="small">Design preview, not the official town site. The official site is <a href="{{ site.officialUrl }}">franconianh.gov</a> (franconianh.org redirects there). Alert dates are sample content from the design prototype. The furnace and ridge marks are original drawings, not traced from landmarks. Phone and street address are carried over from the previous site; bracketed values such as [hours] are still unknown.</p>
  </div>
</footer>
