<footer class="foot" data-pagefind-ignore>
  {% if footerStyle != "simple" %}
  <div class="ridge">{% include "partials/footer-ridge.njk" %}</div>
  <div class="trees">{% include "partials/footer-trees.njk" %}</div>
  {% endif %}
  <div class="in fi">
    {% if footerStyle == "simple" %}
    <p><strong>Town of Franconia, New Hampshire</strong> · Clerk: {{ site.contact.phone }} · {{ site.contact.email }} · Hours: {{ site.contact.hours }}</p>
    <p><a href="{{ '/' | url }}">← Town homepage</a> · <a href="{{ '/archive/' | url }}">Document archive</a></p>
    <p><a href="{{ site.visiting.url }}">{{ site.visiting.text }}</a></p>
    {% else %}
    <p><strong>Town of Franconia, New Hampshire</strong><br>Clerk: {{ site.contact.phone }} · {{ site.contact.email }} · {{ site.contact.address }} · Hours: {{ site.contact.hours }}</p>
    <p><a href="{{ '/about/' | url }}">About Franconia</a> · <a href="{{ site.visiting.url }}">Visiting?</a> · <a href="{{ '/archive/' | url }}">Document archive</a></p>
    <p><a href="{{ site.visiting.url }}">{{ site.visiting.text }}</a></p>
    {% endif %}
    {% include "partials/season-controls.njk" %}
    <p class="small">Design preview, not the official town site. The official site is <a href="{{ site.officialUrl }}">franconianh.gov</a> (franconianh.org redirects there). The furnace and ridge marks are original drawings, not traced from landmarks. Homepage phones, hours, and the clerk email are copied from the public town site. A figure that is not published is left off.</p>
  </div>
</footer>
