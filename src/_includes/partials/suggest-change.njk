{%- set editUrl = page.inputPath | suggestEditUrl(suggestSource, site.repo) -%}
{%- if editUrl -%}
<div class="page-controls" id="page-controls" data-pagefind-ignore>
  <div class="page-controls-bar" id="page-controls-panel">
    <div class="page-controls-edit">
      <a class="suggest-edit" href="{{ editUrl }}">
        <svg class="suggest-pencil" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M9.2 2.3 13.7 6.8 6.2 14.3 2.2 15l.7-4.1 6.3-8.6z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path><path d="M8.1 3.4 12.6 7.9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>
        Suggest a change
      </a>
      <button type="button" class="suggest-info" aria-label="How suggesting a change works" aria-haspopup="dialog" aria-controls="suggest-how">
        {% include "partials/info-icon.njk" %}
      </button>
    </div>
    <div class="text-size" data-text-size-control role="group" aria-label="Text size">
      <button type="button" data-step="small" aria-pressed="false" aria-label="Smaller text">A−</button>
      <button type="button" data-step="medium" aria-pressed="true" aria-label="Default text size">A</button>
      <button type="button" data-step="large" aria-pressed="false" aria-label="Larger text">A+</button>
    </div>
  </div>
  <button type="button" class="page-controls-toggle" aria-expanded="true" aria-controls="page-controls-panel" aria-label="Hide page controls">
    <svg class="page-controls-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.2 6.1 8 10.9l4.8-4.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
  <dialog id="suggest-how" class="suggest-dialog" aria-labelledby="suggest-how-title">
    <div class="suggest-dialog-body">
      <div class="suggest-dialog-top">
        <h2 id="suggest-how-title">How suggesting a change works</h2>
        <form method="dialog">
          <button type="submit" class="suggest-close">Close</button>
        </form>
      </div>
      <p>Anyone can suggest a fix, such as a wrong phone number or an old meeting time. You do not need special software.</p>
      <ol>
        <li>You need a free GitHub account. GitHub is the website where these pages are written. It will help you sign up if you do not have an account yet.</li>
        {% if page.inputPath | suggestFromData(suggestSource) %}
        <li>Suggest a change opens the shared list this page is built from. Change this page’s entry, and leave the others as they are.</li>
        {% else %}
        <li>The link opens this page’s text.</li>
        {% endif %}
        <li>Make your edit.</li>
        <li>Describe what you changed and why.</li>
        <li>Click Propose changes.</li>
        <li>A town reviewer approves it before it appears on the site.</li>
        <li>Every change has a public history. People can see what changed, and when.</li>
      </ol>
      <p>If you would rather just describe the problem, you can open a GitHub issue instead of editing the page.</p>
      <a class="suggest-issue" href="{{ site.repo | suggestIssueUrl }}">Open a GitHub issue instead</a>
    </div>
  </dialog>
</div>
<script>
(function () {
  var root = document.getElementById("page-controls");
  if (!root) return;
  var panel = document.getElementById("page-controls-panel");
  var toggle = root.querySelector(".page-controls-toggle");
  var dialog = root.querySelector("dialog");
  var opener = root.querySelector(".suggest-info");
  var storageKey = "franconia-page-controls";

  function collapsed() {
    return document.documentElement.classList.contains("page-controls-collapsed");
  }

  function sync() {
    var closed = collapsed();
    if (panel) panel.hidden = closed;
    if (!toggle) return;
    toggle.setAttribute("aria-expanded", closed ? "false" : "true");
    toggle.setAttribute("aria-label", closed ? "Show page controls" : "Hide page controls");
  }

  function setCollapsed(closed) {
    document.documentElement.classList.toggle("page-controls-collapsed", closed);
    try {
      if (closed) localStorage.setItem(storageKey, "closed");
      else localStorage.removeItem(storageKey);
    } catch (err) {}
    sync();
  }

  if (toggle) {
    toggle.addEventListener("click", function () {
      setCollapsed(!collapsed());
    });
  }
  sync();

  if (!dialog || !opener || typeof dialog.showModal !== "function") return;
  function focusable() {
    return Array.prototype.filter.call(
      dialog.querySelectorAll("a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex='-1'])"),
      function (el) { return el.getClientRects().length > 0; }
    );
  }
  opener.addEventListener("click", function () {
    if (!dialog.open) dialog.showModal();
  });
  dialog.addEventListener("click", function (event) {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener("keydown", function (event) {
    if (event.key !== "Tab" || !dialog.open) return;
    var items = focusable();
    if (!items.length) return;
    var first = items[0];
    var last = items[items.length - 1];
    var active = document.activeElement;
    if (event.shiftKey && (active === first || !dialog.contains(active))) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && (active === last || !dialog.contains(active))) {
      event.preventDefault();
      first.focus();
    }
  });
  dialog.addEventListener("close", function () {
    opener.focus();
  });
})();
</script>
{%- endif -%}
