<li class="{% if doc.data.needs_review %}is-review{% endif %}" data-body="{{ doc.data.body }}" data-type="{{ doc.data.type }}" data-review="{% if doc.data.needs_review %}yes{% else %}no{% endif %}" data-title="{{ doc.data.title }}">
  <a class="doc-title" href="{{ doc.url | url }}">{{ doc.data.title }}</a>
  <span class="doc-meta">{{ doc.data.doc_date | prettyDate(doc.data.date_precision) }} · {{ doc.data.type }}{% if showBody %} · {{ bodies | bodyName(doc.data.body) }}{% endif %} · {{ doc.data.format }}{% if doc.data.needs_review %} · <span class="flag">Needs review</span>{% endif %}</span>
</li>
