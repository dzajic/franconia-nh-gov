<script>
(function () {
  var months = {
    {% for id, season in seasons %}{% for month in season.months %}{{ month }}: "{{ id }}",{% endfor %}{% endfor %}
  };
  var allowed = { {% for id, season in seasons %}{{ id }}: 1,{% endfor %} };
  var key = "franconia-season";
  function known(value) {
    return value === "auto" || value === "default" || allowed[value];
  }
  var picked = "";
  try {
    picked = (new URLSearchParams(location.search).get("season") || "").toLowerCase();
  } catch (e) {}
  var stored = "";
  try { stored = (localStorage.getItem(key) || "").toLowerCase(); } catch (e) {}
  var legacy = stored;
  if (stored === "off") stored = "default";
  else if (stored === "on" || !stored) stored = "auto";
  else if (!known(stored)) stored = "auto";
  var choice = known(picked) ? picked : stored;
  if (choice !== legacy) {
    try { localStorage.setItem(key, choice); } catch (e) {}
  }
  var season = choice === "auto" ? (months[new Date().getMonth() + 1] || "fall") : choice;
  document.documentElement.setAttribute("data-season", season);
  document.documentElement.setAttribute("data-season-choice", choice);
  window.franconiaSeason = { months: months, allowed: allowed, storageKey: key, choice: choice };
})();
</script>
<style>
@layer seasonal {
{% for id, season in seasons %}
:root[data-season="{{ id }}"] {
  --spr: {{ season.colors.spr }};
  --deep: {{ season.colors.deep }};
  --bark: {{ season.colors.bark }};
  --cream: {{ season.colors.cream }};
  --paper: {{ season.colors.paper }};
  --card: {{ season.colors.card }};
  --blaze: {{ season.colors.blaze }};
  --rust: {{ season.colors.rust }};
  --ink: {{ season.colors.ink }};
  --focus: {{ season.colors.focus }};
  --muted: {{ season.colors.muted }};
  --line: {{ season.colors.line }};
}
{% endfor %}
</style>
