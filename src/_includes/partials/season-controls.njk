<div class="season-controls">
  <label class="season-picker">Seasonal theme
    <select class="season-choice">
      <option value="auto">Auto</option>
      {% for id, season in seasons %}
      <option value="{{ id }}">{{ season.label }}</option>
      {% endfor %}
      <option value="default">Default</option>
    </select>
  </label>
  {% if bodyClass == "home" %}
  <button type="button" class="season-replay" hidden>Replay animation</button>
  {% endif %}
</div>
<script>
(function () {
  var api = window.franconiaSeason || { months: {}, allowed: {}, storageKey: "franconia-season", choice: "auto" };
  var select = document.querySelector(".season-choice");
  var replay = document.querySelector(".season-replay");
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function monthSeason() {
    return api.months[new Date().getMonth() + 1] || "fall";
  }

  function known(value) {
    return value === "auto" || value === "default" || api.allowed[value];
  }

  function paint() {
    var choice = document.documentElement.getAttribute("data-season-choice") || "auto";
    if (select && known(choice)) select.value = choice;
    if (replay) replay.hidden = reduce || document.documentElement.getAttribute("data-season") === "default";
  }

  function apply(choice) {
    if (!known(choice)) return;
    var season = choice === "auto" ? monthSeason() : choice;
    document.documentElement.setAttribute("data-season", season);
    document.documentElement.setAttribute("data-season-choice", choice);
    try { localStorage.setItem(api.storageKey, choice); } catch (e) {}
    try {
      var url = new URL(location.href);
      url.searchParams.delete("season");
      history.replaceState(null, "", url.pathname + url.search + url.hash);
    } catch (e) {}
    paint();
    document.dispatchEvent(new CustomEvent("franconia-season"));
  }

  if (select) {
    select.addEventListener("change", function () { apply(select.value); });
  }

  if (replay) {
    replay.addEventListener("click", function () {
      try { sessionStorage.removeItem("franconia-season-fx"); } catch (e) {}
      document.dispatchEvent(new CustomEvent("franconia-replay"));
    });
  }

  paint();
})();
</script>
