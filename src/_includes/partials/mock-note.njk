<aside class="mock-note" aria-label="Mockup note">
  <p><b>{{ concept.id }} · {{ concept.label }}</b> {{ concept.why }}</p>
  <p class="mock-note-row">
    <a href="{{ '/mockups/photos/' | url }}">All mockups</a>
    <button type="button" data-photo-toggle aria-pressed="false">Hide photo</button>
  </p>
</aside>
