---
layout: shell.njk
pagination:
  data: bodies
  size: 1
  alias: board
permalink: "/archive/{{ board.slug }}/"
eleventyComputed:
  title: "Documents · {{ board.name }}"
  description: "Public documents for {{ board.name }}, grouped by year."
pageScript: /assets/archive-filter.js
---
{% set docs = collections.document | whereBody(board.slug) %}
{% set groups = docs | docsByYear %}
<main id="main" class="in page" data-pagefind-body>
  <p class="more"><a href="{{ '/archive/' | url }}">All documents</a></p>
  <h1 class="page-title">{{ board.name }}</h1>
  <div class="board-meta">
    {% if board.page %}<a href="{{ board.page | url }}">Department page</a>{% endif %}
    <span>Phone: {{ board.phone or "[phone]" }}</span>
    <span>Hours: {{ board.hours or "[hours]" }}</span>
    <span>Meets: {{ board.meets or "[schedule]" }}</span>
  </div>
  {% if board.phoneNote %}<p class="note">{{ board.phoneNote }}</p>{% endif %}
  {% if board.hoursNote %}<p class="note">{{ board.hoursNote }}</p>{% endif %}
  <form class="filters" role="search" data-doc-filter>
    <label>Search titles
      <input id="doc-q" type="search" placeholder="Search this board…" autocomplete="off">
    </label>
    <label>Type
      <select id="doc-type">
        <option value="">All types</option>
        <option>agenda</option>
        <option>minutes</option>
        <option>notice</option>
        <option>budget</option>
        <option>audit</option>
        <option>ordinance</option>
        <option>form</option>
        <option>report</option>
        <option>other</option>
      </select>
    </label>
    <label class="check"><input id="doc-review" type="checkbox"> Needs review</label>
  </form>
  <p id="filter-count" aria-live="polite"></p>
  {% for group in groups %}
  <section class="year-group">
    <h2 class="sign"><span class="blaze" aria-hidden="true"></span>{{ group.year }}</h2>
    <ul class="doclist">
      {% for doc in group.items %}
      <li class="{% if doc.data.needs_review %}is-review{% endif %}" data-body="{{ doc.data.body }}" data-type="{{ doc.data.type }}" data-review="{% if doc.data.needs_review %}yes{% else %}no{% endif %}" data-title="{{ doc.data.title }}">
        <a class="doc-title" href="{{ doc.url | url }}">{{ doc.data.title }}</a>
        <span class="doc-meta">{{ doc.data.doc_date | prettyDate(doc.data.date_precision) }} · {{ doc.data.type }} · {{ doc.data.format }}{% if doc.data.needs_review %} · <span class="flag">Needs review</span>{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% else %}
  <p class="note">No documents have been imported for {{ board.name }} yet. The import script can add them without changing this page.</p>
  {% endfor %}
</main>
